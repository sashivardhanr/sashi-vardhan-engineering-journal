---
import PersonalPage from '../layouts/PersonalPage.astro';
import { contactDestinations, publishedDestinations } from '../data/personal';
const destinations = publishedDestinations(contactDestinations);
---
<PersonalPage title="Contact" description="Contact information for Sashi Vardhan." noindex={!destinations.length}>
  <header class="page-heading"><p class="eyebrow">Contact &amp; profiles</p><h1 id="page-title" tabindex="-1">Start a conversation.</h1><p class="page-intro">For engineering questions, open-source discussions, research or professional opportunities.</p></header>
  <div class="contact-layout">
    <section aria-labelledby="destinations-title"><h2 id="destinations-title">{destinations.length ? 'Direct connections' : 'Contact details pending'}</h2>
      {destinations.length ? <ul class="destinations">{destinations.map(link => <li><a href={link.href}><span class="destination-label">{link.label}</span><span aria-hidden="true">↗</span></a></li>)}</ul> : <p class="pending">Contact options are being reviewed.</p>}
    </section>
    <aside aria-label="Conversation context"><p class="eyebrow">A useful starting point</p><p>A short note about the question, project or opportunity gives the conversation some context.</p><p class="meta">For background on my interests and academic context, <a href="/about/">read About</a>.</p></aside>
  </div>
</PersonalPage>
<style>
  .contact-layout { display:grid; grid-template-columns:minmax(0,2fr) minmax(0,1fr); gap:var(--space-9); border-top:1px solid var(--line); padding-top:var(--space-8); }
  .destinations { list-style:none; padding:0; margin:var(--space-6) 0 0; }
  .destinations li { border-top:1px solid var(--line); }
  .destinations li:last-child { border-bottom:1px solid var(--line); }
  .destinations a { display:flex; justify-content:space-between; align-items:baseline; gap:var(--space-4); padding-block:var(--space-6); text-decoration:none; }
  .destinations a:hover .destination-label { text-decoration:underline; }
  .destination-label { font-size:1.125rem; text-decoration:underline; text-underline-offset:.25em; }
  aside p+p { margin-top:var(--space-5); }
  .pending { margin-top:var(--space-5); }
  @media(max-width:47.999rem) { .contact-layout { grid-template-columns:1fr; gap:var(--space-8); } }
</style>
