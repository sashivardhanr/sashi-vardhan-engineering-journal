---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomePage from '../components/HomePage.astro';
import { publishedProjects } from '../data/projects';
// Published case studies lead the interests section; empty work is omitted.
const order = publishedProjects.length > 0 ? 'b' : 'a';
---
<BaseLayout><HomePage projects={publishedProjects} order={order} /></BaseLayout>
