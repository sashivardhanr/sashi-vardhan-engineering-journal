---
import { profile } from '../data/profile';
interface Props { hasWork?: boolean }
const { hasWork = false } = Astro.props;
---
<section class="introduction" aria-labelledby="intro">
  <div>
    <p class="eyebrow">Personal engineering journal</p>
    <h1 id="intro" tabindex="-1">{profile.headline}</h1>
    <p class="lead">{profile.introduction}</p>
    <p class="interests-copy">A personal space for engineering questions, ideas in development, and the work that follows.</p>
    <a class="action" href={hasWork ? '#work' : '#interests'}>{hasWork ? 'Selected work' : 'Explore my interests'} <span aria-hidden="true">↘</span></a>
  </div>
  <aside class="margin-note" aria-label="About the journal">
    <span class="eyebrow">The journal</span>
    <p>Questions.<br />Methods.<br />Evidence.</p>
    <span class="margin-rule" aria-hidden="true"></span>
    <p class="small">A growing record of engineering exploration.</p>
  </aside>
</section>
<style>
  .introduction { display:grid; grid-template-columns:minmax(0,1fr) 12.5rem; gap:var(--space-9); padding-block:var(--space-9); }
  h1 { max-width:21ch; font-size:clamp(2.5rem, 1.65rem + 2.8vw, 4.25rem); line-height:1.12; letter-spacing:-.025em; text-wrap:balance; }
  .lead { margin-top:var(--space-6); font-size:1.125rem; max-width:46ch; }
  .interests-copy { margin-top:var(--space-3); max-width:50ch; color:var(--muted); }
  .action { margin-top:var(--space-6); }
  .margin-note { border-left:1px solid var(--line); padding-left:var(--space-6); align-self:center; }
  .margin-note>p { font:1.625rem/1.45 var(--font-editorial); }
  .margin-rule { display:block; width:2rem; height:1px; background:var(--accent); margin-block:var(--space-6); }
  .margin-note .small { font:var(--text-meta)/1.6 var(--font-body); color:var(--muted); }
  @media(max-width:47.999rem) {
    .introduction { display:block; padding-block:var(--space-8); }
    h1 { font-size:clamp(2.25rem, 10.2vw, 2.75rem); max-width:21ch; }
    .margin-note { display:none; }
  }
</style>
