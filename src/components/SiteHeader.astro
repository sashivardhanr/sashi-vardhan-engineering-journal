---
import { profile } from '../data/profile';
interface Props { enhance?: boolean; hasWork?: boolean }
const { enhance = true } = Astro.props;
const links = [{ href: '/', label: 'Home' }, { href: '/about/', label: 'About' }, { href: '/now/', label: 'Now' }, { href: '/contact/', label: 'Contact' }];
const currentPath = Astro.url.pathname.replace(/\/?$/, '/');
---
<header class="site-header" id="top">
  <a class="wordmark" href="/">{profile.name}<span>Engineering & exploration</span></a>
  <nav class="desktop-nav" aria-label="Main navigation">
    {links.map(link => <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>)}
  </nav>
  <details class="mobile-menu" id="mobile-menu">
    <summary>Menu <span class="menu-symbol" aria-hidden="true">+</span></summary>
    <nav aria-label="Mobile navigation">
      {links.map(link => <a href={link.href} aria-current={currentPath === link.href ? 'page' : undefined}>{link.label}</a>)}
    </nav>
  </details>
  <div class="theme-slot">
    <label class="theme-control" data-theme-control hidden>
      <span>Theme</span>
      <select id="theme-choice" aria-label="Colour theme">
        <option value="system">System</option><option value="light">Light</option><option value="dark">Dark</option>
      </select>
    </label>
  </div>
</header>
{enhance && <script>import '../scripts/preferences';</script>}
<style>
  .site-header { display:grid; grid-template-columns:1fr auto auto; gap:var(--space-6); align-items:center; padding-block:var(--space-6); border-bottom:1px solid var(--text); }
  .wordmark { text-decoration:none; font-size:1.375rem; letter-spacing:-.025em; line-height:1.25; width:fit-content; }
  .wordmark span { display:block; margin-top:var(--space-2); font-size:var(--text-meta); letter-spacing:.04em; }
  .desktop-nav { display:flex; gap:var(--space-5); font-size:var(--text-meta); }
  .desktop-nav a { display:flex; align-items:center; min-height:var(--target); text-decoration:none; }
  .desktop-nav a:hover { text-decoration:underline; }
  nav a[aria-current='page'] { color:var(--accent); text-decoration:underline; text-decoration-thickness:2px; text-underline-offset:.4em; }
  .theme-slot { min-height:var(--target); min-width:8.5rem; }
  .theme-control { display:flex; align-items:center; gap:var(--space-2); font-size:var(--text-meta); }
  select { min-height:var(--target); min-width:5.75rem; padding-inline:var(--space-2); color:var(--text); background:var(--bg); border:1px solid var(--control); border-radius:var(--radius-control); font:inherit; }
  .mobile-menu { display:none; }
  @media(max-width:55.999rem) {
    .site-header { grid-template-columns:1fr auto; gap:var(--space-3) var(--space-4); padding-block:var(--space-5); }
    .wordmark { font-size:1.25rem; }
    .wordmark span { font-size:var(--text-meta); max-width:16ch; line-height:1.5; }
    .desktop-nav { display:none; }
    .mobile-menu { display:block; justify-self:end; }
    summary { min-height:var(--target); min-width:4.5rem; display:flex; align-items:center; justify-content:space-between; gap:var(--space-3); cursor:pointer; font-size:1rem; list-style:none; }
    summary::-webkit-details-marker { display:none; }
    .mobile-menu[open] { grid-column:1/-1; width:100%; }
    .mobile-menu[open] summary { justify-content:flex-end; }
    .mobile-menu[open] .menu-symbol { transform:rotate(45deg); }
    .mobile-menu nav { display:flex; flex-direction:column; padding-block:var(--space-2); }
    .mobile-menu a { min-height:var(--target); display:flex; align-items:center; }
    .theme-slot { grid-column:1/-1; justify-self:end; }
  }
</style>
