---
import type { EvidenceItem } from '../data/projects';
interface Props { items: readonly EvidenceItem[] }
const { items } = Astro.props;
---
{items.length > 0 && <dl class="evidence-record">
  {items.map(item => <div><dt>{item.label}</dt><dd>{item.href ? <a href={item.href}>{item.value}</a> : item.value}</dd></div>)}
</dl>}
<style>
  .evidence-record { font-size:var(--text-meta); line-height:1.65; margin-top:var(--space-6); }
  .evidence-record>div { display:grid; grid-template-columns:6.5rem minmax(0,1fr); gap:var(--space-4); padding-block:var(--space-3); border-top:1px solid var(--line); }
  dt { color:var(--muted); } dd { margin:0; overflow-wrap:anywhere; }
  @media(max-width:22rem) { .evidence-record>div { grid-template-columns:1fr; gap:var(--space-1); } }
</style>
