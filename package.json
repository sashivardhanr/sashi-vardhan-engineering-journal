{
  "name": "sashi-vardhan-engineering-journal",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "packageManager": "npm@12.2.2",
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "check": "astro check",
