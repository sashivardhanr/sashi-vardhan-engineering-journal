    "preview:review": "node scripts/preview-review.mjs",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "astro": "7.4.7"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3"
  }
